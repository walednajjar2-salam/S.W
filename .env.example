# Railway / production
JAWDAH_HOST=0.0.0.0
# Railway sets PORT automatically
JAWDAH_DATA_DIR=/app/data
# JAWDAH_DB_PATH=/app/data/jawdah.sqlite3
# JAWDAH_COMPANY_SETTINGS=/app/data/company_settings.json
# JAWDAH_CORS_ORIGIN=*

# Security (required for admin login seed only)
ADMIN_PASSWORD=your-secure-admin-password

# Security (optional)
# JAWDAH_DEBUG=0
# JAWDAH_HSTS=1
# JAWDAH_MAX_JSON_BYTES=1048576
# JAWDAH_LOGIN_RATE_LIMIT=8
# JAWDAH_LOGIN_WINDOW_SEC=300
# JAWDAH_SESSION_HOURS=12

# One-time wipe of all business data on startup (remove after first deploy)
# JAWDAH_FRESH_START=1

# JAWDAH_BACKUP_HOUR=3
# JAWDAH_BACKUP_RETAIN_DAYS=14
# JAWDAH_BACKUP_TZ=Asia/Muscat
# JAWDAH_AUTO_BACKUP=1
# JAWDAH_BACKUP_INTERVAL_HOURS=24
# JAWDAH_BACKUP_RETENTION=30

# Local development
# JAWDAH_PORT=8765
# JAWDAH_DATA_DIR=./data

# Optional Postgres shadow path (primary remains SQLite on Volume)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# LQ_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional offsite webhook push (local Volume mirror is always on)
# LQ_OFFSITE_BACKUP_URL=https://your-webhook-or-receiver.example/backup
# LQ_OFFSITE_BACKUP_TOKEN=

# Object storage — explicit LQ_* or Railway Bucket Variable References (AWS SDK)
# LQ_OBJECT_STORAGE_ENABLED=1
# LQ_OBJECT_STORAGE_BUCKET=your-bucket
# LQ_OBJECT_STORAGE_ACCESS_KEY_ID=
# LQ_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# LQ_OBJECT_STORAGE_REGION=auto
# LQ_OBJECT_STORAGE_ENDPOINT_URL=https://storage.railway.app
# LQ_OBJECT_STORAGE_PREFIX=
# LQ_OBJECT_STORAGE_LOCAL_FALLBACK=1
# Railway Bucket aliases (auto-detected when linked):
# BUCKET=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# REGION=
# ENDPOINT=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_ENDPOINT_URL=

# Staff app channel (optional override)
# LQ_STAFF_APP_VERSION=70.4.0
# LQ_PRODUCTION_URL=https://web-production-08d73.up.railway.app
